{
  "name": "marginalia",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --android",
    "android": "expo run:android",
    "start:lan": "expo start --lan",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "jest",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "sounds": "node scripts/sounds/build.mjs --build --measure --install",
    "bundle": "EXPO_OFFLINE=1 expo export --platform android --output-dir /tmp/marginalia-export",
    "check": "npm run typecheck && npm run lint && npm run test && npm run boundaries"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/dm-mono": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo-google-fonts/special-elite": "^0.4.1",
    "@expo-google-fonts/syne": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-navigation/native": "^7.5.0",
    "expo": "^58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "react": "^19.2.3",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "dependency-cruiser": "^18.5.0",
    "eas-cli": "^24.10.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "playwright": "^1.64.0",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/jest.tz.js",
    "setupFiles": [
      "react-native-gesture-handler/jestSetup.js",
      "<rootDir>/jest.setup.js"
    ],
    "transform": {
      "\\.ogg$": "<rootDir>/node_modules/jest-expo/src/preset/assetFileTransformer.js"
    }
  }
}
