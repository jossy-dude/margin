{
  "name": "marginalia",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --android",
    "android": "expo run:android",
    "start:lan": "expo start --lan",
    "tunnel": "expo start --tunnel",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "jest",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "sounds": "node scripts/synth-sounds.mjs",
    "bundle": "EXPO_OFFLINE=1 expo export --platform android --output-dir /tmp/marginalia-export",
    "check": "npm run typecheck && npm run lint && npm run test && npm run boundaries"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/permanent-marker": "^0.4.0",
    "@expo-google-fonts/special-elite": "^0.4.1",
    "@react-navigation/native": "^7.5.0",
    "expo": "^57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "^57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "^57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "^4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/jest": "~29.5",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2",
    "dependency-cruiser": "^18.5.0",
    "eas-cli": "^24.10.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "~29.7",
    "jest-expo": "~57.0.5",
    "typescript": "~5.9"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "testEnvironment": "node"
  }
}
