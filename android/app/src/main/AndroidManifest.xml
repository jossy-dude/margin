<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- W5 (D9 a). `SCHEDULE_EXACT_ALARM` is what lets expo-notifications' own DATE trigger take the
       exact branch (`canScheduleExactAlarms()` -> `setExactAndAllowWhileIdle`); without the
       declaration that branch is unreachable on Android 12+ and every reminder lands in the inexact
       window the app honestly quotes. `USE_FULL_SCREEN_INTENT` is declared now so the intent is
       grantable, but nothing sets a full-screen intent yet — full-screen ringing is W5b's (D9 b),
       and an undeclared permission could not be granted later without a manifest change + reinstall.
       The module itself declares neither (see reports/w5-d0-mechanism.md §2). -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <!-- v0.9 (WS3). Uninstalling is the one action that deletes the planner, and Android has no dialog an
         app can raise to keep its data — so survival is Auto Backup, declared here. `allowBackup="true"`
         alone is not enough: it inherits the platform default, which backs up "everything not obviously
         transient" and is not a promise about this app's database. The two rule files name the data
         explicitly, and both are referenced because the platform reads exactly one of them:
         `dataExtractionRules` on API 31+, `fullBackupContent` on API 30 and below. Declaring only one
         leaves the other half of the installed base on defaults, which looks identical from here.
         `src/test/native-config.test.ts` pins the attributes, both files, and their includes — the same
         pattern as the updater keys below, and for the same reason: nothing else in the repo reads them. -->
    <!-- v0.3.1 (D10). This native folder is committed, so `npx expo prebuild` does NOT run on build and
         `app.json`'s `updates` block never reaches the APK — these five meta-data entries ARE the update
         configuration. They are what `@expo/config-plugins`' `AndroidConfig.Updates` would write for
         `updates: { enabled: true, url: …, checkAutomatically: 'ON_LOAD', fallbackToCacheTimeout: 0 }`:
         ENABLED true, CHECK_ON_LAUNCH 'ALWAYS' (that is how ON_LOAD is spelled natively),
         LAUNCH_WAIT_MS '0' (never block a launch on the network), the project's update URL, and the
         runtime version by string resource so it can also be overridden per build.
         `src/test/native-config.test.ts` fails if any of this drifts from `app.json` again — the first
         version of this file said ENABLED=false with no URL, which is an updater that can never update. -->
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATE_URL" android:value="https://u.expo.dev/a1177786-3b71-4f60-89b5-30fc633d3534"/>
    <meta-data android:name="expo.modules.updates.EXPO_RUNTIME_VERSION" android:value="@string/expo_runtime_version"/>
    <!-- The channel, as a request header — `expo-updates` reads `expo-channel-name` from here
         (`UpdatesConfiguration.kt`), and an APK built without it asks the update server for no
         channel and is answered with nothing. EAS Build normally injects this; this project builds a
         sideloaded APK from the committed native folder, so it is pinned instead of assumed.
         Keep it equal to the `channel` of the profile being built (`eas.json` → preview). -->
    <meta-data android:name="expo.modules.updates.UPDATES_CONFIGURATION_REQUEST_HEADERS_KEY" android:value="{&quot;expo-channel-name&quot;:&quot;preview&quot;}"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="marginalia"/>
        <data android:scheme="exp+marginalia"/>
      </intent-filter>
    </activity>
  </application>
</manifest>