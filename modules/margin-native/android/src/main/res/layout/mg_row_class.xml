<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/mg_r_root" android:layout_width="match_parent" android:layout_height="42dp"
  android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp">
  <LinearLayout android:layout_width="62dp" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/mg_r_start" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="09:00" android:textColor="@color/mg_ink" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:fontFeatureSettings="tnum" android:maxLines="1"/>
    <TextView android:id="@+id/mg_r_end" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:text="09:50" android:textColor="@color/mg_mut" android:textSize="11sp" android:fontFeatureSettings="tnum" android:maxLines="1"/>
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:id="@+id/mg_r_title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Computer Programming" android:textColor="@color/mg_ink" android:textSize="14sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/mg_r_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="C-4 · Reyes" android:textColor="@color/mg_mut" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <ImageView android:id="@+id/mg_r_live" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginStart="8dp"
    android:src="@drawable/mg_dot_live" android:visibility="gone" android:importantForAccessibility="no"/>
</LinearLayout>
